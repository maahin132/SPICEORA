DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false
DB_NAME=spiceora_db
DB_USER=spiceora_app
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Low-volume testing only: personal Gmail SMTP with a Google App Password.
EMAIL_PROVIDER=gmail
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_LOGIN=
GOOGLE_SMTP_APP_PASSWORD=
DEFAULT_FROM_EMAIL=